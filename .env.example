# ============================================================================
# 100% Open-Source Voice & Pronunciation Engine Configuration
# ============================================================================

# Mode A: Real-Time Multilingual Transcription
MODE_A_DEVICE=cpu
MODE_A_ENGINE=sherpa

# Mode B: On-Demand Pronunciation Assessment
MODE_B_DEVICE=cpu
MODE_B_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft

# Paths to exported Dual-Output (logits + layer 12 hidden_states) ONNX artifacts
MODE_B_MODELS_DIR=models
MODE_B_ONNX_CPU_FILENAME=wav2vec2_int8.onnx
MODE_B_ONNX_GPU_FILENAME=wav2vec2_fp16.onnx
MODE_B_TOKENIZER_DIR=models/tokenizer
MODE_B_HIDDEN_LAYER_INDEX=12

# CPU ProcessPool & ONNX Thread Pinning (prevents CPU thread thrashing)
MODE_B_INTRA_OP_THREADS=2
MODE_B_INTER_OP_THREADS=1
MODE_B_PROCESS_WORKERS=2

# GOP Scoring & Conditional Error Diagnostics Thresholds
MODE_B_GOP_PASS_THRESHOLD=85.0
MODE_B_GOP_WARN_THRESHOLD=60.0

# Audio & VAD Chunking Settings
SAMPLE_RATE=16000
MODE_B_MAX_CHUNK_SECONDS=5.0
MODE_B_TRIM_SILENCE=true
